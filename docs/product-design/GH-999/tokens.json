{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "action": {
      "$value": {
        "alpha": 1,
        "colorSpace": "srgb",
        "components": [0.08, 0.32, 0.76]
      }
    },
    "danger": {
      "$value": {
        "alpha": 1,
        "colorSpace": "srgb",
        "components": [0.72, 0.12, 0.14]
      }
    },
    "surface": {
      "$value": {
        "alpha": 1,
        "colorSpace": "srgb",
        "components": [0.98, 0.98, 0.97]
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "control": {"$value": {"unit": "px", "value": 8}},
    "section": {"$value": {"unit": "px", "value": 24}}
  }
}
