+        "",
+        "schema_version: product-design-evidence/v1",
+        f"issue_id: {issue_id}",
+        "assessment_ready: true",
+        f"current_state: {assessment.current_state}",
+        f"selected_variant: {assessment.selected_variant}",
+        f"profile: {assessment.profile}",
+    ]
